{
  "name": "miriam-beauty",
  "version": "0.1.0",
  "private": true,
  "description": "Miriam Beauty — plataforma de serviços de beleza e produtos recomendados em várias regiões.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "check": "tsc --noEmit && node --check server/index.js && node --check server/routes.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": { "node": ">=20" }
}
