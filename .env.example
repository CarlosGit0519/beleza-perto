# Aplicação
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# Base de dados: futura ligação (ex.: PostgreSQL gerido)
DATABASE_URL=

# Email transacional (configurar quando houver domínio e fornecedor)
